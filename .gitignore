# --- Estado de sesión del toolkit (runtime, no versionar) ---
.session.json

# --- Generado / regenerable ---
# out/ es desechable (volcados de RAM, módulos, capturas, logs). Se regenera con tools/.
# Se conservan solo las configuraciones del emulador (*.uae), que son entradas, no salidas.
**/out/*
!**/out/*.uae

# --- Python ---
__pycache__/
*.pyc

# --- Binarios compilados ---
*.exe
*.o
*.obj
*.dll

# --- Sistema / editor ---
Thumbs.db
desktop.ini
*.tmp
*.log

# --- Nodo Arte: evidencias pesadas (regenerables) frente a curaduría ---
platforms/computers/amiga500/demos/arte/rom/raw/
platforms/computers/amiga500/demos/arte/extraction/ram/
platforms/computers/amiga500/demos/arte/extraction/modules/
platforms/computers/amiga500/demos/arte/extraction/modules_all/
platforms/computers/amiga500/demos/arte/extraction/display/
platforms/computers/amiga500/demos/arte/extraction/screens/
platforms/computers/amiga500/demos/arte/extraction/logs/
platforms/computers/amiga500/demos/arte/extraction/ghidra/
platforms/computers/amiga500/demos/arte/extraction/pp20/

# --- Salidas generadas de reimpl (tests) ---
platforms/computers/amiga500/demos/arte/reimplementation/reference/**/anim/
platforms/computers/amiga500/demos/arte/reimplementation/reference/**/anim_arte/
platforms/computers/amiga500/demos/arte/reimplementation/reference/**/canvas/
platforms/computers/amiga500/demos/arte/reimplementation/reference/**/sphere_frame_*.raw
platforms/computers/amiga500/demos/arte/reimplementation/reference/**/*_test

# --- Volcados binarios auxiliares de herramientas (regenerables, no son fuente) ---
tools/node/*.bin
tools/out/

