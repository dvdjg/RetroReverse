# --- Estado de sesión del toolkit (runtime, no versionar) ---
.session.json

# --- Generado / regenerable ---
# out/ es desechable (volcados de RAM, módulos, capturas, logs). Se regenera con tools/.
# Se conservan solo las configuraciones del emulador (*.uae), que son entradas, no salidas.
**/out/*
!**/out/*.uae

# --- Python ---
__pycache__/
*.pyc

# --- Binarios compilados ---
*.exe
*.o
*.obj
*.dll

# --- Sistema / editor ---
Thumbs.db
desktop.ini
*.tmp
*.log

# --- Evidencias pesadas por juego (regenerables) frente a curaduría (extraction/) ---
platforms/**/rom/raw/
platforms/**/extraction/ram/
platforms/**/extraction/modules/
platforms/**/extraction/modules_all/
platforms/**/extraction/display/
platforms/**/extraction/screens/
platforms/**/extraction/logs/
platforms/**/extraction/ghidra/
platforms/**/extraction/pp20/

# --- Emulación libretro: trazas/savestates/capturas (regenerables) ---
platforms/**/extraction/traces/
platforms/**/extraction/savestates/
platforms/**/extraction/screenshots/
platforms/**/extraction/memory_dumps/
platforms/**/extraction/dumps/
platforms/**/extraction/re/
platforms/**/extraction/fbneo/

# --- Salidas generadas de reimpl (tests) ---
platforms/computers/amiga500/demos/arte/reimplementation/reference/**/anim/
platforms/computers/amiga500/demos/arte/reimplementation/reference/**/anim_arte/
platforms/computers/amiga500/demos/arte/reimplementation/reference/**/canvas/
platforms/computers/amiga500/demos/arte/reimplementation/reference/**/sphere_frame_*.raw
platforms/computers/amiga500/demos/arte/reimplementation/reference/**/*_test
platforms/computers/amiga500/demos/arte/reimplementation/build/

# --- Volcados binarios auxiliares de herramientas (regenerables, no son fuente) ---
tools/node/*.bin
tools/out/

# --- Emuladores/frontend clonados (pesados; no se versionan) ---
emulators/*/
frontend/*/


# --- orchestrator (build) ---
tools/orchestrator/host_test
tools/orchestrator/vertical_slice
tools/orchestrator/re_drive
tools/orchestrator/test_core.so
tools/orchestrator/test_core.dll
tools/orchestrator/*.ppm

# --- NES reimplementation (build) ---
platforms/consoles/nes/reimplementation/nestest_runner
platforms/consoles/nes/reimplementation/build_trace.txt

# --- Conversión a plataformas destino: salidas y builds (regenerables) ---
conversion/**/generated/*
!conversion/**/generated/README.md
conversion/**/build/
conversion/**/*.nes
conversion/**/*.bin

# --- ROMs propias: recepción central (contenido NUNCA versionado; se conserva la estructura) ---
roms/*
!roms/README.md
!roms/*/
roms/*/*
!roms/*/.gitkeep
!roms/*/README.md

# --- Auxiliares y traspaso (locales, NO versionar) ---
external/
CONTEXT.md

# --- Artefactos de runtime de emuladores (configs generadas) ---
cfg/
tools/orchestrator/cfg/

# --- Proyectos del emulador de reversing (libRetroReversing; regenerables) ---
RE_projects/
**/RE_projects/

# --- Plugins transpilados generados (regenerables con nes_transpiler --emit-lib) ---
conversion/**/transpiled/
*.n2x
*.n2x.json
