# --- Estado de sesión del toolkit (runtime, no versionar) ---
.session.json

# --- Generado / regenerable ---
# out/ es desechable (volcados de RAM, módulos, capturas, logs). Se regenera con tools/.
# Se conservan solo las configuraciones del emulador (*.uae), que son entradas, no salidas.
**/out/*
!**/out/*.uae

# --- Python ---
__pycache__/
*.pyc

# --- Binarios compilados ---
*.exe
*.o
*.obj
*.dll

# --- Sistema / editor ---
Thumbs.db
desktop.ini
*.tmp
*.log

# --- Salidas generadas de reimpl (tests) ---
platforms/computers/amiga500/demos/arte/reimpl/**/anim/
platforms/computers/amiga500/demos/arte/reimpl/**/anim_arte/
platforms/computers/amiga500/demos/arte/reimpl/**/canvas/
platforms/computers/amiga500/demos/arte/reimpl/**/sphere_frame_*.raw

# --- Volcados binarios auxiliares de herramientas (regenerables, no son fuente) ---
tools/node/*.bin
tools/out/

# --- Binarios de test compilados (sin extension, p. ej. bajo WSL) ---
platforms/computers/amiga500/demos/arte/reimpl/**/*_test

